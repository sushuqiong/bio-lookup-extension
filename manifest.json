{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.6.2",
  "description": "__MSG_extDesc__",
  "author": "sushuqiong",
  "homepage_url": "https://github.com/sushuqiong/bio-lookup-extension",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:23119/*"
  ],
  "background": {
    "service_worker": "background.bundle.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "打开生信快查面板"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "zh_CN"
}